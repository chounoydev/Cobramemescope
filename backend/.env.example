PORT=3001
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set DATABASE_URL to your PostgreSQL connection URI (Neon or Supabase).
# For Neon, copy the pooled connection URI from the Neon dashboard's Connect dialog.
# The Postman API key is unrelated and is not used for database access.
DATABASE_URL=
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
COINGECKO_DEMO_API_KEY=
POSTMAN_API_KEY=
GOLDRUSH_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
